# ============================================
# MOKLIK ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file - it contains secrets
# ============================================

# Firebase Configuration
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenAI Configuration
# Get this from https://platform.openai.com/api-keys
# WARNING: For production, move OpenAI calls to backend Cloud Functions
VITE_OPENAI_API_KEY=sk-your_openai_api_key

# PayPal Configuration (Client-side safe values)
# Get these from PayPal Developer Dashboard
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id
VITE_PAYPAL_MONTHLY_PLAN_ID=P-your_monthly_plan_id
VITE_PAYPAL_YEARLY_PLAN_ID=P-your_yearly_plan_id

# ============================================
# SERVER-SIDE SECRETS
# ============================================
# These should NEVER be in client-side code!
# Store them in Firebase Functions config instead:
#
# firebase functions:config:set openai.key="sk-your-key"
# firebase functions:config:set paypal.secret="your-secret"
#
# Then access in Cloud Functions via:
# const openaiKey = functions.config().openai.key;
# ============================================
